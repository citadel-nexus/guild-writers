{
  "name": "@citadel-guilds/writers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "test": "node --test test/build-provenance.check.mjs && vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "package:provenance": "node .github/scripts/package-provenance.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dd-trace": "^5.65.0",
    "hot-shots": "^11.2.0",
    "nats": "^2.29.3",
    "posthog-node": "^5.54.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2",
    "eslint": "^9.37.0",
    "@eslint/js": "^9.37.0",
    "typescript-eslint": "^8.46.1",
    "globals": "^16.4.0"
  },
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  }
}
