# Writers Guild service
PORT=8200
NATS_URL=

# Datadog APM and custom metrics
DD_SERVICE=guild-mcp-quill
DD_ENV=development
DD_VERSION=0.1.0
DD_AGENT_HOST=
DD_DOGSTATSD_PORT=8125

# Datadog mobile RUM (public SDK identifiers supplied at build time)
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=
DD_RUM_SESSION_SAMPLE_RATE=100
APP_VERSION=0.1.0
