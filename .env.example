# Writers Guild service
PORT=8200
NATS_URL=

# Datadog APM and custom metrics
DD_SERVICE=guild-mcp-quill
DD_ENV=development
DD_VERSION=0.1.0
DD_AGENT_HOST=
DD_DOGSTATSD_PORT=8125

# Datadog mobile RUM (public SDK identifiers supplied at build time)
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=
DD_RUM_SESSION_SAMPLE_RATE=100
APP_VERSION=0.1.0

# PostHog aggregate analytics and circuit-breaker flags
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# Customer.io messaging and pseudonymous segmentation
CUSTOMERIO_APP_API_URL=
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_TRACK_API_URL=
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=
CUSTOMERIO_ID_HMAC_KEY=
CUSTOMERIO_QUEST_BROADCAST_ID=
CUSTOMERIO_LORE_BROADCAST_ID=
CUSTOMERIO_CHAMPION_BROADCAST_ID=

# Private source bridges (read-only; values are injected at runtime)
GITLAB_BASE_URL=
GITLAB_PROJECT_ID=
GITLAB_READ_TOKEN=
GITLAB_LORE_PATH=
SUPABASE_URL=
SUPABASE_READ_KEY=
SOURCE_ID_HMAC_KEY=
SOURCE_ACTIVITY_WINDOW_MINUTES=15
SOURCE_ACTIVITY_CAP=10
INTEGRATION_POLL_INTERVAL_MS=60000

# n8n HMAC-authenticated workflow ingress
N8N_WEBHOOK_SECRET=
